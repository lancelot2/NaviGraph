<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navigraph_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 node exposing NaviGraph navigation context (offline bundle or hosted API).</description>
  <maintainer email="conduct@navigraph.cloud">NaviGraph contributors</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>navigraph_msgs</exec_depend>
  <!-- The `navigraph` Python SDK is a pip dependency (pip install navigraph);
       it is not distributed via rosdep. See this package's README. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
