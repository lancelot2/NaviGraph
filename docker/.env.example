# Self-host environment for docker/docker-compose.yml.
# Copy to docker/.env before `docker compose up`. These are the well-known
# Supabase demo credentials — CHANGE them for anything internet-facing.

# Postgres superuser password (shared by the Supabase service roles).
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Must be >= 32 chars. The anon/service keys below are signed with THIS secret.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# JWTs for the anon and service roles (signed with JWT_SECRET, issuer supabase-demo).
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Where the app is reachable in a browser (also the Supabase API origin via the
# gateway). Keep these aligned with the published ports below.
SITE_URL=http://localhost:3000
SUPABASE_PUBLIC_URL=http://localhost:8000

# Vision backend for the app. "mock" needs no key; set "openai" + a key to use
# real vision/embeddings.
VISION_PROVIDER=mock
OPENAI_API_KEY=
