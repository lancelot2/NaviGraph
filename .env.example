# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local

# --- Supabase -------------------------------------------------------------
# For a local stack (`supabase start`), these are the default local values it
# prints — they are the same on every machine and safe to commit. For a hosted
# Supabase project, copy the URL and anon/publishable key from the dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- Vision backend -------------------------------------------------------
# "mock" (default) runs the whole app end-to-end with NO API key.
# Set "openai" to use real vision/embeddings.
VISION_PROVIDER=mock

# Required only when VISION_PROVIDER=openai (server-side secret).
OPENAI_API_KEY=

# Optional: override the OpenAI vision model (default: gpt-4o).
OPENAI_VISION_MODEL=gpt-4o
