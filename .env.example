# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local

# --- Supabase -------------------------------------------------------------
# For a local stack (`supabase start`), these are the default local values it
# prints — they are the same on every machine and safe to commit. For a hosted
# Supabase project, copy the URL and anon/publishable key from the dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- Vision backend -------------------------------------------------------
# "mock" (default) runs the whole app end-to-end with NO API key.
# Set "openai" to use real vision/embeddings.
VISION_PROVIDER=mock

# Required only when VISION_PROVIDER=openai (server-side secret).
OPENAI_API_KEY=

# Optional: override the OpenAI vision model (default: gpt-4o).
OPENAI_VISION_MODEL=gpt-4o

# --- Extractor service (geometry) -----------------------------------------
# Python /extractor service that turns a plan image into room polygons + graph.
# The browser calls it DIRECTLY (Netlify Free caps functions at ~10s, too short
# for the full pipeline), so the URL must be public (NEXT_PUBLIC_).
NEXT_PUBLIC_EXTRACTOR_URL=

# Server-side URL for the optional in-process polygon sharpening (buildGraph);
# unused by the browser-orchestrated path. Safe to leave equal to the public one.
EXTRACTOR_URL=

# On the extractor service itself (e.g. Render), set:
#   NAVIGRAPH_LABELER=openai        # semantic room/passage labels via a VLM
#   OPENAI_API_KEY=sk-...           # the extractor's own key for labeling
#   NAVIGRAPH_ALLOW_ORIGINS=https://your-app-domain   # CORS allowlist
